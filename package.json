{
  "name": "photopea-client",
  "version": "1.0.0",
  "description": "Unofficial desktop shell for Photopea (https://www.photopea.com/). Not affiliated — rights remain with Photopea. | 非官方桌面壳，编辑器来自官网；权益归原作者。",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "node scripts/pack-one.js",
    "pack": "node scripts/pack-one.js",
    "kill-app": "node scripts/kill-app.js",
    "release": "node scripts/release.js",
    "check:readme": "node scripts/check-readme-sync.js",
    "check:i18n": "node -e \"const m=require('./i18n').assertComplete(); if(m.length){console.error(m.join('\\n')); process.exit(1)} console.log('i18n OK', require('./i18n').PP_LANG_CODES.length)\""
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.photopea.client",
    "productName": "PhotopeaClient",
    "files": [
      "main.js",
      "preload.js",
      "pp-cache.js",
      "path-key.js",
      "i18n.js",
      "settings.html",
      "settings-preload.js",
      "formats.js",
      "icon.png"
    ],
    "extraFiles": [
      {
        "from": "associations.default.json",
        "to": "associations.json"
      }
    ],
    "win": {
      "icon": "icon.png",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
